
module(
    name = "cmposer_linux",
    version = "0.1.0"
)


bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "llvm", version = "0.8.26")

bazel_dep(name = "bazel_lib", version = "3.7.2")

toolchain = use_extension("@llvm//extensions:toolchain.bzl", "toolchain")
toolchain.exec(arch = "aarch64", os = "linux")
toolchain.target(arch = "aarch64", os = "linux")

use_repo(toolchain, "llvm_toolchains")
register_toolchains("@llvm_toolchains//:linux_aarch64_to_linux_aarch64")




















